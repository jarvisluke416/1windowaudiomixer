// ============================================================
// COMBINE ALL SAVED TRACKS
// ============================================================

std::string CombineSavedTracks()
{
    if (savedTracks.empty())
        return "";

    double totalLength = 0.0;

    // --------------------------------------------------------
    // Calculate total length
    // --------------------------------------------------------

    for (const std::string& track : savedTracks)
    {
        std::vector<NoteEvent> notes;
        std::vector<DrumEvent> drums;

        double tempo = 120.0;
        double length = 4.0;

        LoadSongText(
            track,
            notes,
            drums,
            tempo,
            length
        );

        if (length > 0.0)
            totalLength += length;
    }

    std::ostringstream output;

    output
        << "TRACK COMBINED\r\n"
        << "TEMPO "
        << static_cast<int>(
            std::round(
                currentTempo.load()
            )
        )
        << "\r\n"
        << "LENGTH "
        << totalLength
        << "\r\n";

    double offset = 0.0;

    // --------------------------------------------------------
    // Combine tracks
    // --------------------------------------------------------

    for (const std::string& track : savedTracks)
    {
        std::vector<NoteEvent> notes;
        std::vector<DrumEvent> drums;

        double tempo = 120.0;
        double trackLength = 4.0;

        LoadSongText(
            track,
            notes,
            drums,
            tempo,
            trackLength
        );

        std::istringstream input(track);
        std::string line;

        while (std::getline(input, line))
        {
            if (line.empty())
                continue;

            std::istringstream lineStream(line);

            std::string command;
            lineStream >> command;

            if (command.empty())
                continue;

            std::string upperCommand =
                upper(command);

            // ------------------------------------------------
            // Skip track metadata
            // ------------------------------------------------

            if (
                upperCommand == "TRACK" ||
                upperCommand == "TEMPO" ||
                upperCommand == "LENGTH")
            {
                continue;
            }

            // ------------------------------------------------
            // DRUM
            // ------------------------------------------------

            if (upperCommand == "DRUM")
            {
                std::string drumType;
                double startBeat = 0.0;

                lineStream
                    >> drumType
                    >> startBeat;

                output
                    << command
                    << " "
                    << drumType
                    << " "
                    << (startBeat + offset)
                    << "\r\n";

                continue;
            }

            // ------------------------------------------------
            // INSTRUMENT / NOTE
            //
            // The first words may contain spaces.
            // The final 3 fields are:
            //
            //     NOTE_NAME START_BEAT DURATION
            //
            // Everything before those fields is the
            // instrument name.
            // ------------------------------------------------

            std::vector<std::string> parts;
            std::string part;

            while (lineStream >> part)
                parts.push_back(part);

            if (parts.size() < 4)
                continue;

            std::string noteName =
                parts[parts.size() - 3];

            double startBeat = 0.0;
            double durationBeats = 1.0;

            try
            {
                startBeat =
                    std::stod(
                        parts[parts.size() - 2]
                    );

                durationBeats =
                    std::stod(
                        parts[parts.size() - 1]
                    );
            }
            catch (...)
            {
                continue;
            }

            // Reconstruct the complete instrument name.
            std::string instrument;

            for (
                size_t i = 0;
                i + 3 < parts.size();
                ++i)
            {
                if (!instrument.empty())
                    instrument += " ";

                instrument += parts[i];
            }

            if (instrument.empty())
                continue;

            output
                << instrument
                << " "
                << noteName
                << " "
                << (startBeat + offset)
                << " "
                << durationBeats
                << "\r\n";
        }

        offset += trackLength;
    }

    return output.str();
}

