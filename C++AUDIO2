// ============================================================
// INSTRUMENT WAVEFORM
// ============================================================

double instrumentWave(
    const std::string& instrument,
    double frequency,
    double t)
{
    double phase =
        2.0 * PI * frequency * t;

    std::string name =
        upper(instrument);

    // ========================================================
    // PIANO FAMILY
    // ========================================================

    if (
        name == "PIANO" ||
        name == "BRIGHT ACOUSTIC PIANO" ||
        name == "ELECTRIC GRAND PIANO" ||
        name == "HONKY TONK PIANO")
    {
        double decay = 1.0;

        if (name == "BRIGHT ACOUSTIC PIANO")
            decay = 2.2;
        else if (name == "ELECTRIC GRAND PIANO")
            decay = 1.9;
        else if (name == "HONKY TONK PIANO")
            decay = 2.8;

        double envelope =
            std::exp(-decay * t);

        double sound =
            std::sin(phase) * 0.90 +
            std::sin(phase * 2.0) * 0.38 +
            std::sin(phase * 3.0) * 0.18 +
            std::sin(phase * 4.0) * 0.08;

        if (name == "BRIGHT ACOUSTIC PIANO")
        {
            sound +=
                std::sin(phase * 5.0) * 0.08;
        }

        if (name == "ELECTRIC GRAND PIANO")
        {
            sound +=
                std::sin(phase * 6.0) * 0.06;
        }

        if (name == "HONKY TONK PIANO")
        {
            sound +=
                std::sin(phase * 7.0) * 0.05;
        }

        return sound * envelope;
    }

    // ========================================================
    // ELECTRIC PIANOS
    // ========================================================

    if (
        name == "ELECTRIC PIANO 1" ||
        name == "ELECTRIC PIANO 2")
    {
        double envelope =
            std::exp(-1.3 * t);

        double bell =
            std::sin(phase * 2.0) *
            0.35;

        double body =
            std::sin(phase) * 0.75 +
            bell +
            std::sin(phase * 3.0) * 0.18 +
            std::sin(phase * 5.0) * 0.08;

        if (name == "ELECTRIC PIANO 2")
        {
            body +=
                std::sin(phase * 7.0) * 0.12;
        }

        return body * envelope;
    }

    // ========================================================
    // HARPSICHORD / CLAVINET
    // ========================================================

    if (name == "HARPSICHORD")
    {
        return
            (
                std::sin(phase) * 0.75 +
                std::sin(phase * 2.0) * 0.50 +
                std::sin(phase * 3.0) * 0.30 +
                std::sin(phase * 4.0) * 0.18
            ) *
            std::exp(-3.8 * t);
    }

    if (name == "CLAVINET")
    {
        double envelope =
            std::exp(-7.0 * t);

        return
            (
                std::sin(phase) * 0.55 +
                std::sin(phase * 2.0) * 0.35 +
                std::sin(phase * 4.0) * 0.25 +
                std::sin(phase * 8.0) * 0.12
            ) *
            envelope;
    }

    // ========================================================
    // MALLET / BELL FAMILY
    // ========================================================

    if (
        name == "CELESTA" ||
        name == "GLOCKENSPIEL" ||
        name == "MUSIC BOX" ||
        name == "VIBRAPHONE" ||
        name == "MARIMBA" ||
        name == "XYLOPHONE" ||
        name == "TUBULAR BELLS" ||
        name == "DULCIMER" ||
        name == "TINKLE BELL")
    {
        double decay = 2.5;

        if (name == "GLOCKENSPIEL")
            decay = 4.5;
        else if (name == "MUSIC BOX")
            decay = 5.5;
        else if (name == "XYLOPHONE")
            decay = 4.0;
        else if (name == "MARIMBA")
            decay = 2.8;
        else if (name == "VIBRAPHONE")
            decay = 1.5;
        else if (name == "TUBULAR BELLS")
            decay = 1.2;

        double envelope =
            std::exp(-decay * t);

        double sound =
            std::sin(phase) * 0.80 +
            std::sin(phase * 2.0) * 0.35 +
            std::sin(phase * 3.0) * 0.20;

        if (
            name == "GLOCKENSPIEL" ||
            name == "TINKLE BELL" ||
            name == "TUBULAR BELLS")
        {
            sound +=
                std::sin(phase * 2.71) * 0.30;
        }

        return sound * envelope;
    }

    // ========================================================
    // ORGAN FAMILY
    // ========================================================

    if (
        name == "DRAWBAR ORGAN" ||
        name == "PERCUSSIVE ORGAN" ||
        name == "ROCK ORGAN" ||
        name == "CHURCH ORGAN" ||
        name == "REED ORGAN")
    {
        double sound =
            std::sin(phase) * 0.60 +
            std::sin(phase * 2.0) * 0.30 +
            std::sin(phase * 3.0) * 0.18 +
            std::sin(phase * 4.0) * 0.12 +
            std::sin(phase * 8.0) * 0.05;

        if (name == "ROCK ORGAN")
            sound += std::sin(phase * 6.0) * 0.15;

        if (name == "CHURCH ORGAN")
            sound += std::sin(phase * 16.0) * 0.06;

        return sound;
    }

    // ========================================================
    // ACCORDION / HARMONICA
    // ========================================================

    if (
        name == "ACCORDION" ||
        name == "TANGO ACCORDION")
    {
        double vibrato =
            1.0 +
            0.006 *
            std::sin(2.0 * PI * 5.0 * t);

        double p =
            phase * vibrato;

        return
            std::sin(p) * 0.65 +
            std::sin(p * 2.0) * 0.35 +
            std::sin(p * 3.0) * 0.18 +
            std::sin(p * 4.0) * 0.10;
    }

    if (name == "HARMONICA")
    {
        return
            (
                std::sin(phase) * 0.65 +
                std::sin(phase * 2.0) * 0.30 +
                std::sin(phase * 3.0) * 0.15
            ) *
            (0.8 + 0.2 * std::sin(phase * 0.5));
    }

    // ========================================================
    // GUITARS
    // ========================================================

    if (
        name == "ACOUSTIC GUITAR NYLON" ||
        name == "ACOUSTIC GUITAR STEEL" ||
        name == "ELECTRIC GUITAR JAZZ" ||
        name == "ELECTRIC GUITAR CLEAN" ||
        name == "ELECTRIC GUITAR MUTED" ||
        name == "OVERDRIVEN GUITAR" ||
        name == "DISTORTION GUITAR" ||
        name == "GUITAR HARMONICS" ||
        name == "GUITAR")
    {
        double decay = 3.8;

        if (name == "ACOUSTIC GUITAR NYLON")
            decay = 4.2;
        else if (name == "ACOUSTIC GUITAR STEEL")
            decay = 3.3;
        else if (name == "ELECTRIC GUITAR JAZZ")
            decay = 2.2;
        else if (name == "ELECTRIC GUITAR MUTED")
            decay = 9.0;
        else if (name == "OVERDRIVEN GUITAR")
            decay = 2.5;
        else if (name == "DISTORTION GUITAR")
            decay = 1.8;

        double attack =
            1.0 -
            std::exp(-120.0 * t);

        double envelope =
            std::exp(-decay * t);

        double sound =
            std::sin(phase) * 0.60 +
            std::sin(phase * 2.0) * 0.30 +
            std::sin(phase * 3.0) * 0.18 +
            std::sin(phase * 5.0) * 0.08;

        if (name == "GUITAR HARMONICS")
        {
            sound =
                std::sin(phase * 2.0) * 0.55 +
                std::sin(phase * 3.0) * 0.35 +
                std::sin(phase * 4.0) * 0.25;
        }

        if (name == "OVERDRIVEN GUITAR")
            sound = std::tanh(sound * 2.2);

        if (name == "DISTORTION GUITAR")
            sound = std::tanh(sound * 4.5);

        return sound * attack * envelope;
    }

    // ========================================================
    // BASS
    // ========================================================

    if (
        name == "ACOUSTIC BASS" ||
        name == "ELECTRIC BASS FINGER" ||
        name == "ELECTRIC BASS PICK" ||
        name == "FRETLESS BASS" ||
        name == "SLAP BASS 1" ||
        name == "SLAP BASS 2" ||
        name == "SYNTH BASS 1" ||
        name == "SYNTH BASS 2" ||
        name == "BASS")
    {
        double envelope =
            std::exp(-1.2 * t);

        double sound =
            std::sin(phase) * 0.90 +
            std::sin(phase * 2.0) * 0.28 +
            std::sin(phase * 3.0) * 0.10;

        if (
            name == "SLAP BASS 1" ||
            name == "SLAP BASS 2")
        {
            sound +=
                std::sin(phase * 6.0) *
                0.15 *
                std::exp(-15.0 * t);
        }

        if (
            name == "SYNTH BASS 1" ||
            name == "SYNTH BASS 2")
        {
            sound =
                std::sin(phase) * 0.75 +
                std::sin(phase * 2.0) * 0.35;
        }

        return sound * envelope;
    }

    // ========================================================
    // STRINGS
    // ========================================================

    if (
        name == "VIOLIN" ||
        name == "VIOLA" ||
        name == "CELLO" ||
        name == "CONTRABASS" ||
        name == "TREMOLO STRINGS" ||
        name == "PIZZICATO STRINGS" ||
        name == "ORCHESTRAL HARP" ||
        name == "STRING ENSEMBLE 1" ||
        name == "STRING ENSEMBLE 2" ||
        name == "SYNTH STRINGS 1" ||
        name == "SYNTH STRINGS 2")
    {
        double attack =
            1.0 -
            std::exp(-5.0 * t);

        double decay =
            std::exp(-0.25 * t);

        double vibrato =
            1.0 +
            0.004 *
            std::sin(2.0 * PI * 5.0 * t);

        double p =
            phase * vibrato;

        double sound =
            std::sin(p) * 0.72 +
            std::sin(p * 2.0) * 0.20 +
            std::sin(p * 3.0) * 0.12;

        if (name == "PIZZICATO STRINGS")
        {
            attack =
                1.0 -
                std::exp(-80.0 * t);

            decay =
                std::exp(-4.5 * t);
        }

        if (name == "TREMOLO STRINGS")
        {
            sound *=
                0.75 +
                0.25 *
                std::sin(
                    2.0 * PI * 7.0 * t
                );
        }

        if (
            name == "STRING ENSEMBLE 1" ||
            name == "STRING ENSEMBLE 2")
        {
            sound +=
                std::sin(p * 4.0) * 0.10;
        }

        return sound * attack * decay;
    }

    // ========================================================
    // CHOIR / VOICE
    // ========================================================

    if (
        name == "CHOIR AAHS" ||
        name == "VOICE OOHS" ||
        name == "SYNTH VOICE")
    {
        double vowel =
            std::sin(phase) * 0.60 +
            std::sin(phase * 2.0) * 0.30 +
            std::sin(phase * 3.0) * 0.20 +
            std::sin(phase * 4.0) * 0.10;

        return
            vowel *
            (
                0.75 +
                0.25 *
                std::sin(
                    2.0 * PI * 5.0 * t
                )
            );
    }

    // ========================================================
    // BRASS
    // ========================================================

    if (
        name == "TRUMPET" ||
        name == "TROMBONE" ||
        name == "TUBA" ||
        name == "MUTED TRUMPET" ||
        name == "FRENCH HORN" ||
        name == "BRASS SECTION" ||
        name == "SYNTH BRASS 1" ||
        name == "SYNTH BRASS 2")
    {
        double attack =
            1.0 -
            std::exp(-35.0 * t);

        double sound =
            std::sin(phase) * 0.45 +
            std::sin(phase * 2.0) * 0.30 +
            std::sin(phase * 3.0) * 0.25 +
            std::sin(phase * 4.0) * 0.18 +
            std::sin(phase * 5.0) * 0.12;

        if (name == "MUTED TRUMPET")
            sound *= 0.75;

        if (name == "TUBA")
            sound =
                std::sin(phase) * 0.80 +
                std::sin(phase * 2.0) * 0.20;

        return sound * attack;
    }

    // ========================================================
    // SAX / WOODWINDS
    // ========================================================

    if (
        name == "SOPRANO SAX" ||
        name == "ALTO SAX" ||
        name == "TENOR SAX" ||
        name == "BARITONE SAX")
    {
        double sound =
            std::sin(phase) * 0.65 +
            std::sin(phase * 2.0) * 0.28 +
            std::sin(phase * 3.0) * 0.20 +
            std::sin(phase * 4.0) * 0.12;

        return
            sound *
            (
                0.8 +
                0.2 *
                std::sin(
                    2.0 * PI * 5.0 * t
                )
            );
    }

    if (
        name == "OBOE" ||
        name == "ENGLISH HORN" ||
        name == "BASSOON" ||
        name == "CLARINET")
    {
        double sound =
            std::sin(phase) * 0.80 +
            std::sin(phase * 3.0) * 0.20 +
            std::sin(phase * 5.0) * 0.10;

        if (name == "CLARINET")
        {
            sound =
                std::sin(phase) * 0.85 +
                std::sin(phase * 3.0) * 0.30 +
                std::sin(phase * 5.0) * 0.12;
        }

        return
            sound *
            std::exp(-0.5 * t);
    }

    // ========================================================
    // FLUTES
    // ========================================================

    if (
        name == "PICCOLO" ||
        name == "FLUTE" ||
        name == "RECORDER" ||
        name == "PAN FLUTE" ||
        name == "BLOWN BOTTLE" ||
        name == "SHAKUHACHI" ||
        name == "WHISTLE" ||
        name == "OCARINA")
    {
        double sound =
            std::sin(phase) * 0.85 +
            std::sin(phase * 2.0) * 0.10;

        if (name == "PICCOLO")
            sound +=
                std::sin(phase * 3.0) * 0.08;

        if (name == "WHISTLE")
            sound =
                std::sin(phase) * 0.95;

        if (name == "OCARINA")
            sound +=
                std::sin(phase * 2.0) * 0.18;

        return
            sound *
            std::exp(-0.7 * t);
    }

    // ========================================================
    // SYNTH LEADS
    // ========================================================

    if (
        name.find("LEAD ") == 0)
    {
        double saw =
            2.0 *
            (
                frequency * t -
                std::floor(
                    frequency * t + 0.5
                )
            );

        double square =
            std::sin(phase) >= 0.0
                ? 1.0
                : -1.0;

        if (
            name == "LEAD 1 SQUARE")
        {
            return square * 0.70;
        }

        if (
            name == "LEAD 2 SAWTOOTH")
        {
            return saw * 0.70;
        }

        if (
            name == "LEAD 3 CALLIOPE")
        {
            return
                saw * 0.55 +
                std::sin(phase * 2.0) * 0.30;
        }

        if (
            name == "LEAD 4 CHIFF")
        {
            return
                saw * 0.50 +
                std::sin(phase * 5.0) *
                std::exp(-12.0 * t) *
                0.30;
        }

        if (
            name == "LEAD 5 CHARANG")
        {
            return
                saw * 0.50 +
                std::sin(phase * 2.0) * 0.35;
        }

        if (
            name == "LEAD 6 VOICE")
        {
            return
                std::sin(phase) * 0.60 +
                std::sin(phase * 2.0) * 0.30;
        }

        if (
            name == "LEAD 7 FIFTHS")
        {
            return
                std::sin(phase) * 0.50 +
                std::sin(phase * 1.5) * 0.40;
        }

        if (
            name == "LEAD 8 BASS LEAD")
        {
            return
                saw * 0.70;
        }
    }

    // ========================================================
    // SYNTH PADS
    // ========================================================

    if (
        name.find("PAD ") == 0)
    {
        double saw =
            2.0 *
            (
                frequency * t -
                std::floor(
                    frequency * t + 0.5
                )
            );

        double slow =
            0.7 +
            0.3 *
            std::sin(
                2.0 * PI * 0.5 * t
            );

        return
            (
                saw * 0.45 +
                std::sin(phase) * 0.40 +
                std::sin(phase * 2.0) * 0.15
            ) *
            slow;
    }

    // ========================================================
    // SYNTH BRASS / SPECIAL FX
    // ========================================================

    if (
        name == "FX 1 RAIN" ||
        name == "FX 2 SOUNDTRACK" ||
        name == "FX 3 CRYSTAL" ||
        name == "FX 4 ATMOSPHERE" ||
        name == "FX 5 BRIGHTNESS" ||
        name == "FX 6 GOBLINS" ||
        name == "FX 7 ECHOES" ||
        name == "FX 8 SCI FI")
    {
        double mod =
            std::sin(
                phase *
                (
                    1.0 +
                    0.5 *
                    std::sin(
                        2.0 * PI * 0.7 * t
                    )
                )
            );

        double envelope =
            std::exp(-0.35 * t);

        return mod * envelope;
    }

    // ========================================================
    // ETHNIC / WORLD
    // ========================================================

    if (
        name == "SITAR" ||
        name == "BANJO" ||
        name == "SHAMISEN" ||
        name == "KOTO" ||
        name == "KALIMBA" ||
        name == "BAGPIPE" ||
        name == "FIDDLE" ||
        name == "SHANAI")
    {
        double sound =
            std::sin(phase) * 0.65 +
            std::sin(phase * 2.0) * 0.30 +
            std::sin(phase * 3.0) * 0.20;

        double envelope =
            std::exp(-2.5 * t);

        if (name == "SITAR")
            sound +=
                std::sin(phase * 5.0) * 0.20;

        if (name == "BANJO")
            envelope =
                std::exp(-5.0 * t);

        if (name == "FIDDLE")
            sound +=
                std::sin(phase * 6.0) * 0.10;

        if (name == "BAGPIPE")
            envelope =
                0.85 +
                0.15 *
                std::sin(
                    2.0 * PI * 5.0 * t
                );

        return sound * envelope;
    }

    // ========================================================
    // PERCUSSION / SOUND EFFECT MIDI PROGRAMS
    // ========================================================

    if (
        name == "AGOGO" ||
        name == "STEEL DRUMS" ||
        name == "WOODBLOCK" ||
        name == "TAIKO DRUM" ||
        name == "MELODIC TOM" ||
        name == "SYNTH DRUM" ||
        name == "REVERSE CYMBAL")
    {
        double envelope =
            std::exp(-4.0 * t);

        double sound =
            std::sin(phase) * 0.70 +
            std::sin(phase * 2.0) * 0.25 +
            std::sin(phase * 3.0) * 0.10;

        if (name == "WOODBLOCK")
        {
            sound =
                std::sin(phase * 2.0) * 0.70;
        }

        if (name == "SYNTH DRUM")
        {
            sound =
                std::sin(phase) *
                std::exp(-15.0 * t);
        }

        return sound * envelope;
    }

    // ========================================================
    // SOUND EFFECTS
    // ========================================================

    if (
        name == "GUITAR FRET NOISE" ||
        name == "BREATH NOISE" ||
        name == "SEASHORE" ||
        name == "BIRD" ||
        name == "TELEPHONE" ||
        name == "HELICOPTER" ||
        name == "APPLAUSE" ||
        name == "GUNSHOT")
    {
        double noise =
            std::sin(
                phase * 17.0
            ) *
            std::sin(
                phase * 23.0
            );

        if (name == "TELEPHONE")
        {
            return
                (
                    std::sin(phase * 2.0) +
                    std::sin(phase * 3.0)
                ) *
                0.35;
        }

        if (name == "HELICOPTER")
        {
            return
                std::sin(
                    2.0 * PI *
                    20.0 *
                    t
                ) *
                std::sin(phase);
        }

        return
            noise *
            std::exp(-6.0 * t);
    }

    // ========================================================
    // LEGACY / UNKNOWN
    // ========================================================

    if (name == "SYNTH")
    {
        double saw =
            2.0 *
            (
                frequency * t -
                std::floor(
                    frequency * t + 0.5
                )
            );

        return saw * 0.8;
    }

    if (name == "ORGAN")
    {
        return
            std::sin(phase) * 0.65 +
            std::sin(phase * 2.0) * 0.25 +
            std::sin(phase * 4.0) * 0.12;
    }

    if (name == "FLUTE")
    {
        return
            (
                std::sin(phase) * 0.85 +
                std::sin(phase * 2.0) * 0.10
            ) *
            std::exp(-0.8 * t);
    }

    if (name == "TRUMPET")
    {
        return
            (
                std::sin(phase) * 0.45 +
                std::sin(phase * 2.0) * 0.30 +
                std::sin(phase * 3.0) * 0.25
            );
    }

    if (name == "BELL")
    {
        return
            (
                std::sin(phase) +
                std::sin(phase * 2.71) * 0.4 +
                std::sin(phase * 4.13) * 0.2
            ) *
            std::exp(-2.2 * t);
    }

    return std::sin(phase);
}

// ============================================================
// DRUMS
// ============================================================

double kick(double t)
{
    if (t < 0.0 || t >= 0.8)
        return 0.0;

    double frequency =
        155.0 * std::exp(-22.0 * t) + 48.0;

    double body =
        std::sin(
            2.0 * PI * frequency * t
        ) * std::exp(-6.0 * t);

    double beater =
        std::sin(
            2.0 * PI * 95.0 * t
        ) * std::exp(-55.0 * t);

    double click =
        noise() * std::exp(-140.0 * t);

    return
        body * 1.20 +
        beater * 0.28 +
        click * 0.025;
}

double snare(double t)
{
    if (t < 0.0 || t >= 0.5)
        return 0.0;

    double wire =
        noise() * std::exp(-17.0 * t);

    double body =
        std::sin(
            2.0 * PI * 190.0 * t
        ) * std::exp(-19.0 * t);

    double ring =
        std::sin(
            2.0 * PI * 330.0 * t
        ) * std::exp(-27.0 * t);

    double attack =
        std::sin(
            2.0 * PI * 1700.0 * t
        ) * std::exp(-105.0 * t);

    return
        wire * 0.68 +
        body * 0.48 +
        ring * 0.16 +
        attack * 0.14;
}

double closedHiHat(double t)
{
    if (t < 0.0 || t >= 0.18)
        return 0.0;

    double metal =
        noise() * 0.72 +
        std::sin(2.0 * PI * 6800.0 * t) * 0.14 +
        std::sin(2.0 * PI * 8900.0 * t) * 0.10 +
        std::sin(2.0 * PI * 11200.0 * t) * 0.06;

    return
        metal *
        std::exp(-38.0 * t) *
        0.55;
}

double openHiHat(double t)
{
    if (t < 0.0 || t >= 0.8)
        return 0.0;

    double metal =
        noise() * 0.72 +
        std::sin(2.0 * PI * 6200.0 * t) * 0.14 +
        std::sin(2.0 * PI * 8400.0 * t) * 0.10 +
        std::sin(2.0 * PI * 10500.0 * t) * 0.06;

    double attack =
        1.0 - std::exp(-120.0 * t);

    return
        metal *
        attack *
        std::exp(-5.0 * t) *
        0.45;
}

double tom(double t, double frequency)
{
    if (t < 0.0 || t >= 0.9)
        return 0.0;

    double pitch =
        frequency *
        (
            1.0 +
            0.15 * std::exp(-8.0 * t)
        );

    double body =
        std::sin(
            2.0 * PI * pitch * t
        );

    double harmonic =
        std::sin(
            2.0 * PI * pitch * 1.98 * t
        ) * 0.16;

    double attack =
        std::sin(
            2.0 * PI * 700.0 * t
        ) * std::exp(-45.0 * t);

    return
        (
            body +
            harmonic +
            attack * 0.08
        ) *
        std::exp(-5.0 * t) *
        0.75;
}

double crash(double t)
{
    if (t < 0.0 || t >= 2.5)
        return 0.0;

    double metal =
        noise() * 0.72 +
        std::sin(2.0 * PI * 3900.0 * t) * 0.10 +
        std::sin(2.0 * PI * 5100.0 * t) * 0.08 +
        std::sin(2.0 * PI * 7300.0 * t) * 0.06;

    return
        metal *
        (1.0 - std::exp(-180.0 * t)) *
        std::exp(-1.7 * t) *
        0.65;
}

double ride(double t)
{
    if (t < 0.0 || t >= 1.5)
        return 0.0;

    double metallicNoise =
        noise() * 0.32;

    double bell =
        std::sin(
            2.0 * PI * 2800.0 * t
        ) * 0.22;

    double metallicTone =
        std::sin(
            2.0 * PI * 4700.0 * t
        ) * 0.15;

    return
        (
            metallicNoise +
            bell +
            metallicTone
        ) *
        std::exp(-2.7 * t) *
        0.45;
}

double rimshot(double t)
{
    if (t < 0.0 || t >= 0.18)
        return 0.0;

    double attack =
        std::sin(
            2.0 * PI * 1250.0 * t
        ) * std::exp(-45.0 * t);

    double wood =
        std::sin(
            2.0 * PI * 420.0 * t
        ) * std::exp(-35.0 * t);

    double click =
        noise() * std::exp(-75.0 * t);

    return
        attack * 0.65 +
        wood * 0.30 +
        click * 0.20;
}

// ============================================================
// MAKE DRUM
// ============================================================

double makeDrum(
    const std::string& type,
    double t)
{
    // --------------------------------------------------------
    // KICKS
    // --------------------------------------------------------

    if (
        type == "KICK" ||
        type == "KICK_2" ||
        type == "KICK_3" ||
        type == "BASS_DRUM" ||
        type == "ELECTRONIC_KICK" ||
        type == "SYNTH_KICK")
    {
        return kick(t);
    }

    // --------------------------------------------------------
    // SNARES
    // --------------------------------------------------------

    if (
        type == "SNARE" ||
        type == "SNARE_2" ||
        type == "SNARE_3" ||
        type == "ELECTRONIC_SNARE" ||
        type == "SYNTH_SNARE")
    {
        return snare(t);
    }

    // --------------------------------------------------------
    // CLAPS
    // --------------------------------------------------------

    if (
        type == "CLAP" ||
        type == "HAND_CLAP" ||
        type == "ELECTRONIC_CLAP" ||
        type == "SYNTH_CLAP")
    {
        return snare(t) * 0.75;
    }

    // --------------------------------------------------------
    // SIDE STICK / RIM
    // --------------------------------------------------------

    if (
        type == "RIMSHOT" ||
        type == "SIDE_STICK" ||
        type == "SYNTH_RIM")
    {
        return rimshot(t);
    }

    // --------------------------------------------------------
    // HI-HATS
    // --------------------------------------------------------

    if (
        type == "HIHAT" ||
        type == "HIHAT_PEDAL" ||
        type == "ELECTRONIC_HIHAT")
    {
        return closedHiHat(t);
    }

    if (
        type == "OPEN_HIHAT" ||
        type == "OPENHIHAT")
    {
        return openHiHat(t);
    }

    // --------------------------------------------------------
    // TOMS
    // --------------------------------------------------------

    if (
        type == "LOW_TOM" ||
        type == "LOW_MID_TOM" ||
        type == "ELECTRONIC_TOM" ||
        type == "SYNTH_TOM")
    {
        return tom(t, 95.0);
    }

    if (
        type == "MID_TOM")
    {
        return tom(t, 145.0);
    }

    if (
        type == "HIGH_MID_TOM")
    {
        return tom(t, 175.0);
    }

    if (
        type == "HIGH_TOM")
    {
        return tom(t, 210.0);
    }

    // --------------------------------------------------------
    // CYMBALS
    // --------------------------------------------------------

    if (
        type == "CRASH" ||
        type == "CRASH_2" ||
        type == "CRASH_SHORT" ||
        type == "CRASH_LONG" ||
        type == "SPLASH" ||
        type == "CHINA")
    {
        return crash(t);
    }

    if (
        type == "RIDE" ||
        type == "RIDE_2" ||
        type == "RIDE_SHORT" ||
        type == "RIDE_LONG" ||
        type == "RIDE_BELL")
    {
        return ride(t);
    }

    // --------------------------------------------------------
    // REVERSE CYMBALS
    // --------------------------------------------------------

    if (
        type == "REVERSE_CRASH" ||
        type == "REVERSE_CYMBAL")
    {
        double value =
            crash(
                std::max(
                    0.0,
                    2.5 - t
                )
            );

        return value;
    }

    // --------------------------------------------------------
    // BASIC PERCUSSION
    // --------------------------------------------------------

    if (
        type == "COWBELL" ||
        type == "COWBELL_LOW" ||
        type == "COWBELL_HIGH" ||
        type == "BELL" ||
        type == "LOW_BELL" ||
        type == "HIGH_BELL")
    {
        double frequency = 900.0;

        if (
            type == "COWBELL_LOW" ||
            type == "LOW_BELL")
        {
            frequency = 600.0;
        }
        else if (
            type == "COWBELL_HIGH" ||
            type == "HIGH_BELL")
        {
            frequency = 1200.0;
        }

        return
            (
                std::sin(
                    2.0 * PI *
                    frequency *
                    t
                ) * 0.7
                +
                std::sin(
                    2.0 * PI *
                    frequency * 1.4 *
                    t
                ) * 0.3
            ) *
            std::exp(-10.0 * t);
    }

    // --------------------------------------------------------
    // WOOD / BLOCK
    // --------------------------------------------------------

    if (
        type == "WOODBLOCK" ||
        type == "CLAVES" ||
        type == "BLOCK_LOW" ||
        type == "BLOCK_HIGH" ||
        type == "WOOD_HIT" ||
        type == "WOOD_CLICK")
    {
        double frequency = 1200.0;

        if (
            type == "BLOCK_LOW" ||
            type == "WOOD_HIT")
        {
            frequency = 700.0;
        }

        if (
            type == "BLOCK_HIGH" ||
            type == "WOOD_CLICK")
        {
            frequency = 1800.0;
        }

        return
            std::sin(
                2.0 * PI *
                frequency *
                t
            ) *
            std::exp(-18.0 * t);
    }

    // --------------------------------------------------------
    // SHAKERS / MARACAS / CABASA
    // --------------------------------------------------------

    if (
        type == "SHAKER" ||
        type == "SHAKER_LOW" ||
        type == "SHAKER_HIGH" ||
        type == "MARACAS" ||
        type == "CABASA")
    {
        double level =
            noise();

        double decay = 14.0;

        if (type == "SHAKER_HIGH")
            decay = 20.0;

        if (type == "SHAKER_LOW")
            decay = 10.0;

        return
            level *
            std::exp(-decay * t) *
            0.65;
    }

    // --------------------------------------------------------
    // TAMBOURINE
    // --------------------------------------------------------

    if (
        type == "TAMBOURINE" ||
        type == "TAMBOURINE_LOW" ||
        type == "TAMBOURINE_HIGH")
    {
        return
            (
                noise() * 0.65 +
                std::sin(
                    2.0 * PI *
                    7500.0 *
                    t
                ) * 0.20
            ) *
            std::exp(-12.0 * t);
    }

    // --------------------------------------------------------
    // AGOGO
    // --------------------------------------------------------

    if (
        type == "AGOGO_LOW" ||
        type == "AGOGO_HIGH")
    {
        double frequency =
            type == "AGOGO_LOW"
            ? 700.0
            : 1100.0;

        return
            (
                std::sin(
                    2.0 * PI *
                    frequency *
                    t
                ) +
                std::sin(
                    2.0 * PI *
                    frequency * 2.0 *
                    t
                ) * 0.35
            ) *
            std::exp(-7.0 * t);
    }

    // --------------------------------------------------------
    // CONGAS
    // --------------------------------------------------------

    if (
        type == "CONGA_LOW" ||
        type == "MUTE_CONGA")
    {
        return tom(t, 100.0);
    }

    if (
        type == "CONGA_MID" ||
        type == "OPEN_CONGA")
    {
        return tom(t, 180.0);
    }

    if (type == "CONGA_HIGH")
    {
        return tom(t, 260.0);
    }

    // --------------------------------------------------------
    // BONGOS
    // --------------------------------------------------------

    if (type == "BONGO_LOW")
        return tom(t, 180.0);

    if (type == "BONGO_HIGH")
        return tom(t, 300.0);

    // --------------------------------------------------------
    // TIMBALES
    // --------------------------------------------------------

    if (type == "TIMBALE_LOW")
        return tom(t, 220.0);

    if (type == "TIMBALE_HIGH")
        return tom(t, 360.0);

    // --------------------------------------------------------
    // DJEMBE
    // --------------------------------------------------------

    if (type == "DJEMBE_LOW")
        return tom(t, 110.0);

    if (type == "DJEMBE_MID")
        return tom(t, 180.0);

    if (type == "DJEMBE_HIGH")
        return tom(t, 260.0);

    // --------------------------------------------------------
    // TABLA
    // --------------------------------------------------------

    if (type == "TABLA_LOW")
        return tom(t, 180.0);

    if (type == "TABLA_HIGH")
        return tom(t, 330.0);

    // --------------------------------------------------------
    // CUICA
    // --------------------------------------------------------

    if (
        type == "CUICA_LOW" ||
        type == "CUICA_HIGH")
    {
        double frequency =
            type == "CUICA_LOW"
            ? 350.0
            : 650.0;

        return
            std::sin(
                2.0 * PI *
                frequency *
                t
            ) *
            std::exp(-7.0 * t);
    }

    // --------------------------------------------------------
    // TRIANGLE
    // --------------------------------------------------------

    if (
        type == "TRIANGLE" ||
        type == "TRIANGLE_OPEN" ||
        type == "TRIANGLE_MUTE")
    {
        double frequency = 4200.0;

        if (type == "TRIANGLE_MUTE")
            frequency = 3200.0;

        return
            std::sin(
                2.0 * PI *
                frequency *
                t
            ) *
            std::exp(-9.0 * t) *
            0.45;
    }

    // --------------------------------------------------------
    // GONG / TAM TAM
    // --------------------------------------------------------

    if (
        type == "GONG" ||
        type == "TAM_TAM")
    {
        return
            (
                std::sin(
                    2.0 * PI *
                    180.0 *
                    t
                ) +
                std::sin(
                    2.0 * PI *
                    270.0 *
                    t
                ) * 0.5
            ) *
            std::exp(-1.5 * t) *
            0.75;
    }

    // --------------------------------------------------------
    // HAND DRUM
    // --------------------------------------------------------

    if (type == "HAND_DRUM")
        return tom(t, 160.0);

    // --------------------------------------------------------
    // FINGER SNAP
    // --------------------------------------------------------

    if (type == "FINGER_SNAP")
    {
        return
            noise() *
            std::exp(-45.0 * t);
    }

    // --------------------------------------------------------
    // NOISE / EFFECTS
    // --------------------------------------------------------

    if (
        type == "NOISE_HIT" ||
        type == "NOISE_BURST" ||
        type == "CLICK" ||
        type == "POP" ||
        type == "DROP" ||
        type == "IMPACT" ||
        type == "IMPACT_LOW" ||
        type == "IMPACT_HIGH")
    {
        double frequency = 1000.0;

        if (type == "IMPACT_LOW")
            frequency = 120.0;

        if (type == "IMPACT_HIGH")
            frequency = 1800.0;

        return
            (
                noise() * 0.65 +
                std::sin(
                    2.0 * PI *
                    frequency *
                    t
                ) * 0.35
            ) *
            std::exp(-8.0 * t);
    }

    // --------------------------------------------------------
    // METAL
    // --------------------------------------------------------

    if (
        type == "METAL_HIT" ||
        type == "METAL_CLANK" ||
        type == "METAL_SCRAPE")
    {
        return
            (
                noise() * 0.7 +
                std::sin(
                    2.0 * PI *
                    4200.0 *
                    t
                ) * 0.3
            ) *
            std::exp(-5.0 * t);
    }

    // --------------------------------------------------------
    // CASTANETS
    // --------------------------------------------------------

    if (type == "CASTANETS")
    {
        return
            noise() *
            std::exp(-55.0 * t);
    }

    // --------------------------------------------------------
    // WHISTLE
    // --------------------------------------------------------

    if (
        type == "WHISTLE_LOW" ||
        type == "WHISTLE_HIGH")
    {
        double frequency =
            type == "WHISTLE_LOW"
            ? 900.0
            : 1800.0;

        return
            std::sin(
                2.0 * PI *
                frequency *
                t
            ) *
            std::exp(-3.0 * t);
    }

    // --------------------------------------------------------
    // BREATH
    // --------------------------------------------------------

    if (type == "BREATH")
    {
        return
            noise() *
            std::exp(-4.0 * t) *
            0.45;
    }

    // --------------------------------------------------------
    // FOOTSTEP
    // --------------------------------------------------------

    if (type == "FOOTSTEP")
    {
        return
            (
                noise() * 0.5 +
                std::sin(
                    2.0 * PI *
                    90.0 *
                    t
                ) * 0.5
            ) *
            std::exp(-12.0 * t);
    }

    // --------------------------------------------------------
    // HEARTBEAT
    // --------------------------------------------------------

    if (type == "HEARTBEAT")
    {
        double pulse1 =
            std::sin(
                2.0 * PI *
                65.0 *
                t
            ) *
            std::exp(-18.0 * t);

        double pulse2 =
            std::sin(
                2.0 * PI *
                50.0 *
                std::max(
                    0.0,
                    t - 0.12
                )
            ) *
            std::exp(
                -18.0 *
                std::max(
                    0.0,
                    t - 0.12
                )
            );

        return
            pulse1 +
            pulse2 * 0.7;
    }

    // --------------------------------------------------------
    // LASER
    // --------------------------------------------------------

    if (
        type == "LASER_HIT" ||
        type == "LASER_LOW" ||
        type == "LASER_HIGH")
    {
        double frequency = 900.0;

        if (type == "LASER_LOW")
            frequency = 300.0;

        if (type == "LASER_HIGH")
            frequency = 1800.0;

        return
            std::sin(
                2.0 * PI *
                frequency *
                t
            ) *
            std::exp(-6.0 * t);
    }

    // --------------------------------------------------------
    // EXPLOSION
    // --------------------------------------------------------

    if (type == "EXPLOSION")
    {
        return
            (
                noise() * 0.8 +
                std::sin(
                    2.0 * PI *
                    70.0 *
                    t
                ) * 0.4
            ) *
            std::exp(-2.5 * t);
    }

    // --------------------------------------------------------
    // TAIKO / TIMPANI / LARGE DRUMS
    // --------------------------------------------------------

    if (
        type == "TIMPANI" ||
        type == "TAIKO" ||
        type == "GRANDE_CASSA")
    {
        return tom(t, 65.0);
    }

    // --------------------------------------------------------
    // ORCHESTRA HIT
    // --------------------------------------------------------

    if (type == "ORCHESTRA_HIT")
    {
        return
            (
                snare(t) * 0.3 +
                tom(t, 180.0) * 0.6
            );
    }

    // --------------------------------------------------------
    // UNKNOWN DRUM
    // --------------------------------------------------------

    return 0.0;
}

// ============================================================
// LOAD SONG TEXT
// ============================================================

bool LoadSongText(
    const std::string& text,
    std::vector<NoteEvent>& notes,
    std::vector<DrumEvent>& drums,
    double& tempo,
    double& loopLengthBeats)
{
    notes.clear();
    drums.clear();

    tempo = 120.0;
    loopLengthBeats = 4.0;

    std::vector<std::string> instruments =
        GetInstruments();

    // --------------------------------------------------------
    // Sort longest names first.
    //
    // This prevents a shorter name from matching before a
    // longer instrument name.
    // --------------------------------------------------------

    std::sort(
        instruments.begin(),
        instruments.end(),
        [](const std::string& a,
           const std::string& b)
        {
            return a.length() > b.length();
        }
    );

    std::istringstream input(text);
    std::string line;

    while (std::getline(input, line))
    {
        if (line.empty())
            continue;

        // ----------------------------------------------------
        // Remove Windows CR if present.
        // ----------------------------------------------------

        if (!line.empty() &&
            line.back() == '\r')
        {
            line.pop_back();
        }

        std::istringstream lineStream(line);

        std::string firstWord;
        lineStream >> firstWord;

        if (firstWord.empty())
            continue;

        std::string command =
            upper(firstWord);

        // ----------------------------------------------------
        // TEMPO
        // ----------------------------------------------------

        if (command == "TEMPO")
        {
            lineStream >> tempo;

            tempo =
                std::max(
                    MIN_TEMPO,
                    std::min(
                        MAX_TEMPO,
                        tempo
                    )
                );

            continue;
        }

        // ----------------------------------------------------
        // LENGTH
        // ----------------------------------------------------

        if (command == "LENGTH")
        {
            lineStream >> loopLengthBeats;

            if (loopLengthBeats <= 0)
                loopLengthBeats = 4.0;

            continue;
        }

        // ----------------------------------------------------
        // TRACK
        // ----------------------------------------------------

        if (command == "TRACK")
            continue;

        // ----------------------------------------------------
        // DRUM
        // ----------------------------------------------------

        if (command == "DRUM")
        {
            std::string type;
            double startBeat = 0.0;

            lineStream
                >> type
                >> startBeat;

            if (!type.empty())
            {
                drums.push_back(
                    {
                        startBeat,
                        upper(type)
                    }
                );
            }

            continue;
        }

        // ----------------------------------------------------
        // NOTE
        // ----------------------------------------------------

        if (command == "NOTE")
        {
            std::string noteName;
            double startBeat = 0.0;
            double durationBeats = 1.0;

            lineStream
                >> noteName
                >> startBeat
                >> durationBeats;

            double frequency =
                noteFrequency(
                    upper(noteName)
                );

            if (frequency > 0.0)
            {
                notes.push_back(
                    {
                        startBeat,
                        durationBeats,
                        frequency,
                        "PIANO"
                    }
                );
            }

            continue;
        }

        // ----------------------------------------------------
        // INSTRUMENT
        //
        // Examples:
        //
        // PIANO C4 0 1
        // ELECTRIC GRAND PIANO C4 0 1
        // ACOUSTIC GUITAR STEEL G4 2 1
        //
        // We match the complete instrument name at the
        // beginning of the line.
        // ----------------------------------------------------

        std::string upperLine =
            upper(line);

        std::string matchedInstrument;
        size_t instrumentEnd = 0;

        for (
            const std::string& instrument :
            instruments)
        {
            std::string upperInstrument =
                upper(instrument);

            if (upperLine.length() <
                upperInstrument.length())
            {
                continue;
            }

            if (
                upperLine.compare(
                    0,
                    upperInstrument.length(),
                    upperInstrument
                ) != 0)
            {
                continue;
            }

            // Make sure the instrument name ends at
            // a word boundary.
            //
            // Example:
            //
            // PIANO C4 0 1
            //
            // should match PIANO.
            //
            // But:
            //
            // PIANOXYZ C4 0 1
            //
            // should NOT match PIANO.

            size_t next =
                upperInstrument.length();

            if (
                next < upperLine.length() &&
                !std::isspace(
                    static_cast<unsigned char>(
                        upperLine[next]
                    )
                )
            )
            {
                continue;
            }

            matchedInstrument =
                instrument;

            instrumentEnd =
                next;

            break;
        }

        // ----------------------------------------------------
        // No valid instrument found.
        // ----------------------------------------------------

        if (matchedInstrument.empty())
            continue;

        // ----------------------------------------------------
        // Everything after the instrument name is:
        //
        // NOTE START DURATION
        // ----------------------------------------------------

        std::string remainder =
            line.substr(
                instrumentEnd
            );

        std::istringstream noteStream(
            remainder
        );

        std::string noteName;
        double startBeat = 0.0;
        double durationBeats = 1.0;

        noteStream
            >> noteName
            >> startBeat
            >> durationBeats;

        if (noteName.empty())
            continue;

        double frequency =
            noteFrequency(
                upper(noteName)
            );

        if (frequency <= 0.0)
            continue;

        notes.push_back(
            {
                startBeat,
                durationBeats,
                frequency,
                matchedInstrument
            }
        );
    }

    return true;
}

// ============================================================
// EDITOR TEXT
// ============================================================

std::string GetEditorText()
{
    if (!songEditor)
        return "";

    int length =
        GetWindowTextLengthA(songEditor);

    if (length <= 0)
        return "";

    std::string text(
        length + 1,
        '\0'
    );

    int actualLength =
        GetWindowTextA(
            songEditor,
            &text[0],
            length + 1
        );

    text.resize(actualLength);

    return text;
}

void SetEditorText(
    const std::string& text)
{
    if (!songEditor)
        return;

    SetWindowTextA(
        songEditor,
        text.c_str()
    );
}

void InsertEditorText(
    const std::string& text)
{
    if (!songEditor)
        return;

    SendMessageA(
        songEditor,
        EM_REPLACESEL,
        TRUE,
        reinterpret_cast<LPARAM>(
            text.c_str()
        )
    );
}

// ============================================================
// VOLUME
// ============================================================

double GetVolumeMultiplier(int level)
{
    switch (level)
    {
        case 1: return 2.0;
        case 2: return 3.5;
        case 3: return 5.0;
        default: return 1.0;
    }
}

// ============================================================
// GENERATE AUDIO
// ============================================================

bool GenerateAudio(
    const std::string& text,
    double tempoOverride,
    int pitchSemitones,
    double volumeMultiplier,
    std::vector<short>& samples)
{
    std::vector<NoteEvent> notes;
    std::vector<DrumEvent> drums;

    double fileTempo;
    double loopLengthBeats;

    if (!LoadSongText(
        text,
        notes,
        drums,
        fileTempo,
        loopLengthBeats))
    {
        return false;
    }

    double tempo =
        std::max(
            MIN_TEMPO,
            std::min(MAX_TEMPO, tempoOverride)
        );

    int pitch =
        std::max(
            MIN_PITCH,
            std::min(MAX_PITCH, pitchSemitones)
        );

    double pitchMultiplier =
        std::pow(
            2.0,
            static_cast<double>(pitch) / 12.0
        );

    double secondsPerBeat =
        60.0 / tempo;

    double loopDuration =
        loopLengthBeats *
        secondsPerBeat;

    int totalSamples =
        static_cast<int>(
            std::round(
                loopDuration *
                SAMPLE_RATE
            )
        );

    if (totalSamples <= 0)
        return false;

    std::vector<double> audio(
        totalSamples,
        0.0
    );

    // --------------------------------------------------------
    // NOTES
    // --------------------------------------------------------

    for (const NoteEvent& note : notes)
    {
        double startSeconds =
            note.startBeat *
            secondsPerBeat;

        double durationSeconds =
            note.durationBeats *
            secondsPerBeat;

        int startSample =
            static_cast<int>(
                std::round(
                    startSeconds *
                    SAMPLE_RATE
                )
            );

        int noteSamples =
            static_cast<int>(
                std::round(
                    durationSeconds *
                    SAMPLE_RATE
                )
            );

        double shiftedFrequency =
            note.frequency *
            pitchMultiplier;

        for (int i = 0;
             i < noteSamples;
             ++i)
        {
            int index =
                startSample + i;

            if (index < 0)
                continue;

            if (index >= totalSamples)
                break;

            double time =
                static_cast<double>(i) /
                SAMPLE_RATE;

            double envelope = 1.0;

            if (time < 0.01)
                envelope =
                    time / 0.01;

            double remaining =
                durationSeconds - time;

            if (remaining < 0.05)
            {
                envelope =
                    std::min(
                        envelope,
                        std::max(
                            0.0,
                            remaining / 0.05
                        )
                    );
            }

            audio[index] +=
                instrumentWave(
                    note.instrument,
                    shiftedFrequency,
                    time
                ) *
                envelope *
                0.55;
        }
    }

    // --------------------------------------------------------
    // DRUMS
    // --------------------------------------------------------

    for (const DrumEvent& drum : drums)
    {
        double startSeconds =
            drum.startBeat *
            secondsPerBeat;

        int startSample =
            static_cast<int>(
                std::round(
                    startSeconds *
                    SAMPLE_RATE
                )
            );

        int drumSamples =
            static_cast<int>(
                2.5 *
                SAMPLE_RATE
            );

        for (int i = 0;
             i < drumSamples;
             ++i)
        {
            int index =
                startSample + i;

            if (index < 0)
                continue;

            if (index >= totalSamples)
                break;

            double time =
                static_cast<double>(i) /
                SAMPLE_RATE;

            double drumVolume = 1.0;

            if (
                drum.type == "KICK" ||
                drum.type == "BASS_DRUM")
                drumVolume = 2.25;
            else if (drum.type == "SNARE")
                drumVolume = 1.70;
            else if (
                drum.type == "HIHAT" ||
                drum.type == "CLOSED_HIHAT")
                drumVolume = 0.85;
            else if (drum.type == "OPEN_HIHAT")
                drumVolume = 0.95;
            else if (
                drum.type == "LOW_TOM" ||
                drum.type == "MID_TOM" ||
                drum.type == "HIGH_TOM")
                drumVolume = 1.15;
            else if (drum.type == "CRASH")
                drumVolume = 1.05;
            else if (drum.type == "RIDE")
                drumVolume = 0.85;
            else if (drum.type == "RIMSHOT")
                drumVolume = 0.90;

            audio[index] +=
                makeDrum(
                    drum.type,
                    time
                ) *
                drumVolume;
        }
    }

   // --------------------------------------------------------
// MASTER
// --------------------------------------------------------

if (volumeMultiplier < 1.0)
    volumeMultiplier = 1.0;

samples.resize(totalSamples);

for (int i = 0;
     i < totalSamples;
     ++i)
{
    double value =
        audio[i] *
        MASTER_VOLUME *
        volumeMultiplier;

    value =
        std::tanh(value);

    samples[i] =
        static_cast<short>(
            value * 32767.0
        );
}

return true;
}

// ============================================================
// WAV WRITER
// ============================================================

bool SaveWavFile(
    const std::string& filename,
    const std::vector<short>& samples)
{
    std::ofstream file(
        filename,
        std::ios::binary
    );

    if (!file)
        return false;

    const uint32_t dataSize =
        static_cast<uint32_t>(
            samples.size() *
            sizeof(short)
        );

    const uint32_t fmtSize = 16;
    const uint16_t audioFormat = 1;
    const uint16_t channels = 1;
    const uint32_t sampleRate = SAMPLE_RATE;
    const uint16_t bitsPerSample = 16;

    const uint16_t blockAlign =
        channels *
        bitsPerSample /
        8;

    const uint32_t byteRate =
        sampleRate *
        blockAlign;

    const uint32_t riffSize =
        4 +
        8 + fmtSize +
        8 + dataSize;

    file.write(
        "RIFF",
        4
    );

    file.write(
        reinterpret_cast<const char*>(
            &riffSize
        ),
        sizeof(riffSize)
    );

    file.write(
        "WAVE",
        4
    );

    file.write(
        "fmt ",
        4
    );

    file.write(
        reinterpret_cast<const char*>(
            &fmtSize
        ),
        sizeof(fmtSize)
    );

    file.write(
        reinterpret_cast<const char*>(
            &audioFormat
        ),
        sizeof(audioFormat)
    );

    file.write(
        reinterpret_cast<const char*>(
            &channels
        ),
        sizeof(channels)
    );

    file.write(
        reinterpret_cast<const char*>(
            &sampleRate
        ),
        sizeof(sampleRate)
    );

    file.write(
        reinterpret_cast<const char*>(
            &byteRate
        ),
        sizeof(byteRate)
    );

    file.write(
        reinterpret_cast<const char*>(
            &blockAlign
        ),
        sizeof(blockAlign)
    );

    file.write(
        reinterpret_cast<const char*>(
            &bitsPerSample
        ),
        sizeof(bitsPerSample)
    );

    file.write(
        "data",
        4
    );

    file.write(
        reinterpret_cast<const char*>(
            &dataSize
        ),
        sizeof(dataSize)
    );

    if (dataSize > 0)
    {
        file.write(
            reinterpret_cast<const char*>(
                samples.data()
            ),
            dataSize
        );
    }

    return file.good();
}

// ============================================================
// TEMPORARY WAV FILE
// ============================================================

std::string MakeTemporaryWav()
{
    char tempPath[MAX_PATH] = {};

    DWORD pathLength =
        GetTempPathA(
            MAX_PATH,
            tempPath
        );

    if (pathLength == 0 ||
        pathLength >= MAX_PATH)
    {
        return "";
    }

    char tempFile[MAX_PATH] = {};

    if (GetTempFileNameA(
        tempPath,
        "MTE",
        0,
        tempFile) == 0)
    {
        return "";
    }

    // GetTempFileNameA creates a .tmp file.
    // Delete that file and use the same unique name
    // with a .wav extension instead.

    DeleteFileA(tempFile);

    std::string filename = tempFile;

    size_t dot =
        filename.find_last_of('.');

    if (dot != std::string::npos)
    {
        filename =
            filename.substr(0, dot);
    }

    filename += ".wav";

    return filename;
}
// ============================================================
// SHELL QUOTE
// ============================================================

std::string QuoteArgument(
    const std::string& value)
{
    std::string result = "\"";

    for (char c : value)
    {
        if (c == '"')
            result += "\\\"";
        else
            result += c;
    }

    result += "\"";

    return result;
}

// ============================================================
// RUN FFMPEG
// ============================================================
bool RunFFmpeg(
    const std::string& arguments)
{
    std::string command =
        QuoteArgument(FFMPEG_PATH) +
        " " +
        arguments;

    MessageBoxA(
        mainWindow,
        command.c_str(),
        "FFmpeg Command",
        MB_OK | MB_ICONINFORMATION
    );

    STARTUPINFOA startupInfo = {};
    PROCESS_INFORMATION processInfo = {};

    startupInfo.cb = sizeof(startupInfo);

    std::vector<char> commandLine(
        command.begin(),
        command.end()
    );

    commandLine.push_back('\0');

    BOOL created =
        CreateProcessA(
            nullptr,
            commandLine.data(),
            nullptr,
            nullptr,
            FALSE,
            0,
            nullptr,
            nullptr,
            &startupInfo,
            &processInfo
        );

    if (!created)
    {
        DWORD error = GetLastError();

        std::string message =
            "CreateProcess failed.\r\n\r\nError code: " +
            std::to_string(error);

        MessageBoxA(
            mainWindow,
            message.c_str(),
            "FFmpeg Error",
            MB_OK | MB_ICONERROR
        );

        return false;
    }

    WaitForSingleObject(
        processInfo.hProcess,
        INFINITE
    );

    DWORD exitCode = 1;

    GetExitCodeProcess(
        processInfo.hProcess,
        &exitCode
    );

    CloseHandle(processInfo.hProcess);
    CloseHandle(processInfo.hThread);

    if (exitCode != 0)
    {
        std::string message =
            "FFmpeg exited with error code " +
            std::to_string(exitCode) +
            "\r\n\r\nCommand:\r\n" +
            command;

        MessageBoxA(
            mainWindow,
            message.c_str(),
            "FFmpeg Error",
            MB_OK | MB_ICONERROR
        );

        return false;
    }

    return true;
}
// ============================================================
// CHECK FFMPEG
// ============================================================

bool CheckFFmpeg()
{
    STARTUPINFOA startupInfo = {};
    PROCESS_INFORMATION processInfo = {};

    startupInfo.cb =
        sizeof(startupInfo);

    std::string command =
        QuoteArgument(
            FFMPEG_PATH
        ) +
        " -version";

    std::vector<char> commandLine(
        command.begin(),
        command.end()
    );

    commandLine.push_back('\0');

    BOOL created =
        CreateProcessA(
            nullptr,
            commandLine.data(),
            nullptr,
            nullptr,
            FALSE,
            CREATE_NO_WINDOW,
            nullptr,
            nullptr,
            &startupInfo,
            &processInfo
        );

    if (!created)
        return false;

    WaitForSingleObject(
        processInfo.hProcess,
        5000
    );

    DWORD exitCode = 1;

    GetExitCodeProcess(
        processInfo.hProcess,
        &exitCode
    );

    CloseHandle(
        processInfo.hProcess
    );

    CloseHandle(
        processInfo.hThread
    );

    return exitCode == 0;
}

// ============================================================
// EXPORT WAV
// ============================================================

void ExportCurrentTrackWav()
{
    std::string text =
        GetEditorText();

    if (text.empty())
    {
        MessageBoxA(
            mainWindow,
            "The editor is empty.",
            "EXPORT WAV",
            MB_OK | MB_ICONINFORMATION
        );

        return;
    }

    std::vector<short> samples;

    if (!GenerateAudio(
        text,
        currentTempo.load(),
        currentPitch.load(),
        GetVolumeMultiplier(
            volumeBoost.load()
        ),
        samples))
    {
        MessageBoxA(
            mainWindow,
            "Could not generate audio.",
            "EXPORT WAV",
            MB_OK | MB_ICONERROR
        );

        return;
    }

    char filename[MAX_PATH] =
        "track.wav";

    OPENFILENAMEA dialog = {};

    dialog.lStructSize =
        sizeof(OPENFILENAMEA);

    dialog.hwndOwner =
        mainWindow;

    dialog.lpstrFilter =
        "WAV Audio (*.wav)\0*.wav\0"
        "All Files (*.*)\0*.*\0";

    dialog.lpstrFile =
        filename;

    dialog.nMaxFile =
        MAX_PATH;

    dialog.Flags =
        OFN_OVERWRITEPROMPT |
        OFN_PATHMUSTEXIST;

    dialog.lpstrDefExt =
        "wav";

    if (!GetSaveFileNameA(&dialog))
        return;

    if (!SaveWavFile(
        filename,
        samples))
    {
        MessageBoxA(
            mainWindow,
            "Could not save the WAV file.",
            "EXPORT WAV",
            MB_OK | MB_ICONERROR
        );

        return;
    }

    MessageBoxA(
        mainWindow,
        "WAV exported successfully.",
        "EXPORT WAV",
        MB_OK | MB_ICONINFORMATION
    );
}

